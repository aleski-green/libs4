cabal-version: 3.0
name: sapiens-domain
version: 0.2.0.0
build-type: Simple

common runtime
  default-language: Haskell2010
  default-extensions: OverloadedStrings, ScopedTypeVariables, TupleSections
  ghc-options: -threaded -rtsopts -O1 -Wall -Werror=incomplete-patterns -Werror=incomplete-uni-patterns -Werror=missing-fields
  build-depends: base >=4.18 && <5, aeson ==2.3.2.0, bytestring, text, containers,
    directory, filepath, process, time, async, stm, scientific, vector,
    sqlite-simple, filelock, uuid, base64-bytestring, network-uri, regex-tdfa,
    http-client, http-client-tls, http-types, network, wai, warp, wai-websockets,
    websockets, wuss, cryptohash-sha256, random, tagsoup ==0.14.8
  if !os(windows)
    build-depends: unix

executable sapiens-domain
  main-is: Work/Schedule/Main.hs
  hs-source-dirs: ../../sapiens
  other-modules: Work.Schedule.Command, Work.Schedule.Wire
  build-depends: base >=4.18 && <5, aeson ==2.3.2.0, bytestring
  default-language: Haskell2010
  ghc-options: -O2 -Wall -Werror

executable sapiens4
  import: runtime
  hs-source-dirs: ../../sapiens, ../../web/shell
  other-modules:
    Work.Schedule.Command,
    State.Domain,
    Host.Assets,
    BuildUI,
    Work.Computer,
    Work.Delegation,
    Work.Execution,
    Work.GroupChat,
    State.GroupModel,
    Work.GroupWork,
    Work.Groups,
    Host.HTTP,
    Host.Management,
    State.Memo,
    State.Population,
    Work.Provider,
    Host.Remote.Bridge,
    Host.Remote.Client,
    Host.Remote.Crypto,
    Host.Remote.Mailboxes,
    Host.Remote.Registry,
    Host.Remote.Receipt,
    Host.Remote.Relay,
    Host.Remote.Setup,
    Host.Remote.Transport,
    Work.Routines,
    Host.Server,
    Host.Service,
    State.Store,
    State.Types,
    State.Workspace,
    Work.Schedule.Wire
  main-is: Main.hs
  extra-lib-dirs: sodium/src/libsodium/.libs
  extra-libraries: sodium

executable sapiens-macos
  import: runtime
  hs-source-dirs: ../../osspecific/macos, ../../sapiens
  other-modules:
    State.Domain,
    Application,
    Browser,
    Icon,
    ObjC
  main-is: MacMain.hs
  if os(osx)
    c-sources: native/cocoa.c
    frameworks: Cocoa, WebKit, CoreGraphics
    extra-libraries: objc
  else
    buildable: False

executable sapiens-windows
  import: runtime
  hs-source-dirs: ../../osspecific/windows, ../../sapiens
  other-modules:
    State.Domain,
    Browser,
    Host,
    Native,
    Navigation,
    Shell
  main-is: WindowsMain.hs
  if os(windows)
    c-sources: native/windows.c
    ld-options: .build/windows-resources.o
    ghc-options: -optl-mwindows
    extra-libraries: user32, ole32, dwmapi, comdlg32, kernel32
  else
    buildable: False

executable sapiens-windows-probe
  import: runtime
  hs-source-dirs: ../../spec/support, ../../osspecific/windows, ../../sapiens
  other-modules:
    State.Domain,
    Browser,
    Host,
    Native,
    Navigation,
    Shell
  main-is: WindowsProbeMain.hs
  if os(windows)
    c-sources: native/windows.c
    extra-libraries: user32, ole32, dwmapi, comdlg32, kernel32
  else
    buildable: False

executable sapiens-provider
  main-is: WindowsProviderMain.hs
  hs-source-dirs: ../../spec/support
  default-language: Haskell2010
  build-depends: base >=4.18 && <5, process
  if !os(windows)
    buildable: False

executable sapiens-peer
  main-is: Peer.hs
  hs-source-dirs: ../../spec/support
  default-language: Haskell2010
  ghc-options: -threaded -O1 -Wall
  build-depends: base >=4.18 && <5, aeson, async, base64-bytestring, bytestring,
    containers, network-uri, stm, text, websockets, wuss
  extra-lib-dirs: sodium/src/libsodium/.libs
  extra-libraries: sodium
