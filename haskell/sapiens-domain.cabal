cabal-version: 3.0
name: sapiens-domain
version: 0.1.0.0
build-type: Simple
executable sapiens-domain
  main-is: Main.hs
  hs-source-dirs: ../../sapiens/corpora/host/routine
  other-modules: Command, Wire
  build-depends: base >=4.18 && <5, aeson ==2.3.2.0, bytestring >=0.11 && <0.13
  default-language: Haskell2010
  ghc-options: -O2 -Wall -Werror
