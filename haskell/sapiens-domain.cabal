cabal-version: 3.0
name: sapiens-domain
version: 0.2.0.0
build-type: Simple

common runtime
  hs-source-dirs: ../../haskell, ../../sapiens/corpora/host/routine
  default-language: Haskell2010
  default-extensions: OverloadedStrings, ScopedTypeVariables, TupleSections
  ghc-options: -threaded -rtsopts -O1 -Wall -Werror=incomplete-patterns -Werror=incomplete-uni-patterns -Werror=missing-fields
  build-depends: base >=4.18 && <5, aeson ==2.3.2.0, bytestring, text, containers,
    directory, filepath, process, time, async, stm, scientific, vector,
    sqlite-simple, filelock, uuid, base64-bytestring, network-uri, regex-tdfa,
    http-client, http-client-tls, http-types, network, wai, warp, wai-websockets,
    websockets, wuss, cryptohash-sha256, random, tagsoup ==0.14.8
  if !os(windows)
    build-depends: unix

executable sapiens-domain
  main-is: Main.hs
  hs-source-dirs: ../../sapiens/corpora/host/routine
  other-modules: Command, Wire
  build-depends: base >=4.18 && <5, aeson ==2.3.2.0, bytestring
  default-language: Haskell2010
  ghc-options: -O2 -Wall -Werror

executable sapiens4
  import: runtime
  other-modules:
    Command,
    Sapiens.Domain,
    Sapiens.Assets,
    Sapiens.BuildUI,
    Sapiens.Computer,
    Sapiens.Delegation,
    Sapiens.Execution,
    Sapiens.GroupChat,
    Sapiens.GroupModel,
    Sapiens.GroupWork,
    Sapiens.Groups,
    Sapiens.HTTP,
    Sapiens.Management,
    Sapiens.Memo,
    Sapiens.Population,
    Sapiens.Provider,
    Sapiens.Remote.Bridge,
    Sapiens.Remote.Client,
    Sapiens.Remote.Crypto,
    Sapiens.Remote.Mailboxes,
    Sapiens.Remote.Registry,
    Sapiens.Remote.Receipt,
    Sapiens.Remote.Relay,
    Sapiens.Remote.Setup,
    Sapiens.Remote.Transport,
    Sapiens.Routines,
    Sapiens.Server,
    Sapiens.Service,
    Sapiens.Store,
    Sapiens.Types,
    Sapiens.Workspace,
    Wire
  main-is: Main.hs
  extra-lib-dirs: sodium/src/libsodium/.libs
  extra-libraries: sodium

executable sapiens-macos
  import: runtime
  other-modules:
    Sapiens.Domain,
    Sapiens.Desktop.Mac.Application,
    Sapiens.Desktop.Mac.Browser,
    Sapiens.Desktop.Mac.Icon,
    Sapiens.Desktop.Mac.ObjC
  main-is: MacMain.hs
  if os(osx)
    c-sources: native/cocoa.c
    frameworks: Cocoa, WebKit, CoreGraphics
    extra-libraries: objc
  else
    buildable: False

executable sapiens-windows
  import: runtime
  other-modules:
    Sapiens.Domain,
    Sapiens.Desktop.Windows.Browser,
    Sapiens.Desktop.Windows.Host,
    Sapiens.Desktop.Windows.Native,
    Sapiens.Desktop.Windows.Navigation,
    Sapiens.Desktop.Windows.Shell
  main-is: WindowsMain.hs
  if os(windows)
    c-sources: native/windows.c
    ld-options: .build/windows-resources.o
    ghc-options: -optl-mwindows
    extra-libraries: user32, ole32, dwmapi, comdlg32, kernel32
  else
    buildable: False

executable sapiens-windows-probe
  import: runtime
  other-modules:
    Sapiens.Domain,
    Sapiens.Desktop.Windows.Browser,
    Sapiens.Desktop.Windows.Host,
    Sapiens.Desktop.Windows.Native,
    Sapiens.Desktop.Windows.Navigation,
    Sapiens.Desktop.Windows.Shell
  main-is: WindowsProbeMain.hs
  if os(windows)
    c-sources: native/windows.c
    extra-libraries: user32, ole32, dwmapi, comdlg32, kernel32
  else
    buildable: False

executable sapiens-provider
  main-is: WindowsProviderMain.hs
  hs-source-dirs: ../../haskell
  default-language: Haskell2010
  build-depends: base >=4.18 && <5, process
  if !os(windows)
    buildable: False

executable sapiens-peer
  main-is: Peer.hs
  hs-source-dirs: ../../spec/support/haskell
  default-language: Haskell2010
  ghc-options: -threaded -O1 -Wall
  build-depends: base >=4.18 && <5, aeson, async, base64-bytestring, bytestring,
    containers, network-uri, stm, text, websockets, wuss
  extra-lib-dirs: sodium/src/libsodium/.libs
  extra-libraries: sodium
